# Copy to .env, use a unique random password (at least 12 characters).
ADMIN_USER=admin
ADMIN_PASSWORD=
NEW_API_DATA_DIR=/data/DockerCompose/oneapi/data
BIND_IP=127.0.0.1
REPORT_TIMEZONE=Asia/Taipei
# Estimated amount = log quota / QUOTA_PER_UNIT; not subscription invoice.
QUOTA_PER_UNIT=500000
QUOTA_CURRENCY=USD
# Enable when accessing through an HTTPS reverse proxy.
COOKIE_SECURE=false

# Writable metrics-only settings folder. Create and grant UID 65532 access.
METRICS_STATE_DIR=./state
